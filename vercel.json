{
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/partner-with-us.html",
      "destination": "/partner-with-us",
      "permanent": true
    },
    {
      "source": "/how-it-works.html",
      "destination": "/how-it-works",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.marinmusicgroup.com"
        }
      ],
      "destination": "/artist-operations-portal/:path*"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/partner-with-us",
      "destination": "/partner-with-us.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    }
  ]
}
